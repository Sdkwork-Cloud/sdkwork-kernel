{
  "schema_version": "0.1.0",
  "manifest_type": "agent_provider_binding",
  "binding_id": "binding.claude-code",
  "agent_id": "agent.claude-code",
  "display_name": "Claude Code",
  "description": "External agent provider binding for Anthropic Claude Code CLI and agent SDK surfaces.",
  "version": "0.1.0",
  "sdk_owner": "anthropic",
  "status": "standardizing",
  "kernel_compatibility": {
    "agent_kernel": ">=0.1.0 <0.2.0"
  },
  "language_packages": {
    "typescript": {
      "package": "@anthropic-ai/claude-agent-sdk",
      "version": "0.3.220",
      "optional": false
    }
  },
  "selection_policy": {
    "default_backend_priority": [
      "typescript_node",
      "ipc_protocol"
    ]
  },
  "capabilities": [
    {
      "capability_id": "sdk.session.lifecycle",
      "required": true,
      "execution_scope": "transport_runtime",
      "backends": [
        {
          "kind": "typescript_node",
          "driver_id": "driver.claude-code.session.lifecycle.ts",
          "runtime_operations": ["ping", "session_list", "session_history"],
          "package": "@anthropic-ai/claude-agent-sdk"
        },
        {
          "kind": "ipc_protocol",
          "driver_id": "driver.claude-code.session.lifecycle.ipc",
          "runtime_operations": ["ping"],
          "transport": "jsonrpc_stdio"
        }
      ]
    },
    {
      "capability_id": "sdk.model.chat",
      "required": true,
      "execution_scope": "transport_runtime",
      "backends": [
        {
          "kind": "typescript_node",
          "driver_id": "driver.claude-code.model.chat.ts",
          "runtime_operations": ["ping", "model_chat", "model_chat_stream"],
          "package": "@anthropic-ai/claude-agent-sdk"
        }
      ]
    },
    {
      "capability_id": "sdk.session.control",
      "required": false,
      "execution_scope": "transport_runtime",
      "backends": [
        {
          "kind": "typescript_node",
          "driver_id": "driver.claude-code.session.control.ts",
          "runtime_operations": ["ping", "session_interrupt", "session_fork"],
          "package": "@anthropic-ai/claude-agent-sdk"
        }
      ]
    }
  ],
  "integration_sources": [
    {
      "mode": "official_sdk",
      "package": "@anthropic-ai/claude-agent-sdk"
    },
    {
      "mode": "ipc_protocol",
      "transport": "jsonrpc_stdio"
    }
  ]
}
