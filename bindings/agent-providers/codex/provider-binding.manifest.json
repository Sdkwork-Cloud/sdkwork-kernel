{
  "schema_version": "0.1.0",
  "manifest_type": "agent_provider_binding",
  "binding_id": "binding.agent-provider.codex",
  "agent_id": "agent.intelligence.codex",
  "display_name": "OpenAI Codex",
  "description": "External agent provider binding for OpenAI Codex app-server and CLI runtimes.",
  "version": "0.1.0",
  "sdk_owner": "openai",
  "status": "standardizing",
  "kernel_compatibility": {
    "agent_kernel": ">=0.1.0 <0.2.0"
  },
  "language_packages": {
    "rust": {
      "crate": "codex-app-server-client",
      "version": "0.0.0",
      "optional": false
    },
    "typescript": {
      "package": "@openai/codex-sdk",
      "version": "0.146.0",
      "optional": false
    }
  },
  "selection_policy": {
    "default_backend_priority": [
      "typescript_node",
      "rust_native",
      "ipc_protocol"
    ]
  },
  "capabilities": [
    {
      "capability_id": "sdk.session.lifecycle",
      "required": true,
      "execution_scope": "provider_local",
      "backends": [
        {
          "kind": "rust_native",
          "driver_id": "driver.codex.session.lifecycle.rust",
          "runtime_operations": ["ping"],
          "crate": "codex-app-server-client"
        },
        {
          "kind": "ipc_protocol",
          "driver_id": "driver.codex.session.lifecycle.ipc",
          "runtime_operations": ["ping"],
          "transport": "jsonrpc_stdio"
        }
      ]
    },
    {
      "capability_id": "sdk.session.history",
      "required": true,
      "execution_scope": "provider_local",
      "backends": [
        {
          "kind": "rust_native",
          "driver_id": "driver.codex.session.history.rust",
          "runtime_operations": ["ping"],
          "crate": "codex-app-server-client"
        }
      ]
    },
    {
      "capability_id": "sdk.model.chat",
      "required": true,
      "execution_scope": "transport_runtime",
      "backends": [
        {
          "kind": "typescript_node",
          "driver_id": "driver.codex.model.chat.ts",
          "runtime_operations": ["ping", "model_chat", "model_chat_stream"],
          "package": "@openai/codex-sdk"
        },
        {
          "kind": "rust_native",
          "driver_id": "driver.codex.model.chat.rust",
          "runtime_operations": ["ping", "model_chat", "model_chat_stream"],
          "crate": "codex-core"
        },
        {
          "kind": "ipc_protocol",
          "driver_id": "driver.codex.model.chat.ipc",
          "runtime_operations": ["ping", "model_chat", "model_chat_stream"],
          "transport": "jsonrpc_stdio"
        }
      ]
    },
    {
      "capability_id": "sdk.model.stream",
      "required": false,
      "execution_scope": "transport_runtime",
      "backends": [
        {
          "kind": "rust_native",
          "driver_id": "driver.codex.model.stream.rust",
          "runtime_operations": ["ping", "model_chat_stream"],
          "crate": "codex-core"
        }
      ]
    }
  ],
  "integration_sources": [
    {
      "mode": "official_sdk",
      "package": "@openai/codex-sdk"
    },
    {
      "mode": "rust_crate",
      "crate": "codex-app-server-client"
    },
    {
      "mode": "rust_crate",
      "crate": "codex-app-server-protocol"
    },
    {
      "mode": "rust_crate",
      "crate": "codex-core"
    },
    {
      "mode": "source_tree",
      "path": "external/codex/codex-rs/app-server-client"
    },
    {
      "mode": "source_tree",
      "path": "external/codex/codex-rs/app-server-protocol"
    },
    {
      "mode": "ipc_protocol",
      "transport": "jsonrpc_stdio"
    }
  ]
}
