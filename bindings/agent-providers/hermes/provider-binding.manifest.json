{
  "schema_version": "0.1.0",
  "manifest_type": "agent_provider_binding",
  "binding_id": "binding.agent-provider.hermes",
  "agent_id": "agent.intelligence.hermes",
  "display_name": "Hermes Agent",
  "description": "External agent provider binding for Hermes Agent Python runtime and TUI gateway JSON-RPC.",
  "version": "0.2.0",
  "sdk_owner": "nousresearch",
  "status": "experimental",
  "kernel_compatibility": {
    "agent_kernel": ">=0.1.0 <0.2.0"
  },
  "language_packages": {
    "python": {
      "module": "run_agent",
      "version": "0.17.0",
      "optional": false
    },
    "typescript": {
      "package": "hermes-ink",
      "optional": true
    }
  },
  "capabilities": [
    {
      "capability_id": "sdk.session.lifecycle",
      "required": true,
      "execution_scope": "provider_local",
      "backends": [
        {
          "kind": "python_process",
          "driver_id": "driver.hermes.session.lifecycle.python",
          "runtime_operations": ["ping"],
          "python_module": "hermes_state"
        },
        {
          "kind": "ipc_protocol",
          "driver_id": "driver.hermes.session.lifecycle.ipc",
          "runtime_operations": ["ping"],
          "transport": "jsonrpc_stdio"
        }
      ]
    },
    {
      "capability_id": "sdk.model.chat",
      "required": true,
      "execution_scope": "transport_runtime",
      "backends": [
        {
          "kind": "python_process",
          "driver_id": "driver.hermes.model.chat.python",
          "runtime_operations": ["ping", "model_chat", "model_chat_stream"],
          "python_module": "run_agent"
        },
        {
          "kind": "ipc_protocol",
          "driver_id": "driver.hermes.model.chat.ipc",
          "runtime_operations": ["ping", "model_chat", "model_chat_stream"],
          "transport": "jsonrpc_stdio"
        }
      ]
    },
    {
      "capability_id": "sdk.tool.invoke",
      "required": false,
      "execution_scope": "transport_runtime",
      "backends": [
        {
          "kind": "python_process",
          "driver_id": "driver.hermes.tool.invoke.python",
          "runtime_operations": ["ping", "tool_invoke"],
          "python_module": "model_tools"
        }
      ]
    },
    {
      "capability_id": "sdk.skill.invoke",
      "required": false,
      "execution_scope": "transport_runtime",
      "backends": [
        {
          "kind": "python_process",
          "driver_id": "driver.hermes.skill.invoke.python",
          "runtime_operations": ["ping", "skill_invoke"],
          "python_module": "agent.skill_commands"
        }
      ]
    }
  ],
  "integration_sources": [
    {
      "mode": "python_module",
      "module": "run_agent"
    },
    {
      "mode": "ipc_protocol",
      "transport": "jsonrpc_stdio"
    }
  ]
}
