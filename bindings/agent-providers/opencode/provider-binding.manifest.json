{
  "schema_version": "0.1.0",
  "manifest_type": "agent_provider_binding",
  "binding_id": "binding.agent-provider.opencode",
  "agent_id": "agent.intelligence.opencode",
  "display_name": "OpenCode",
  "description": "External agent provider binding for OpenCode Bun/TypeScript server SDK surfaces.",
  "version": "0.1.0",
  "sdk_owner": "sst",
  "status": "experimental",
  "kernel_compatibility": {
    "agent_kernel": ">=0.1.0 <0.2.0"
  },
  "language_packages": {
    "typescript": {
      "package": "@opencode-ai/sdk",
      "optional": false
    }
  },
  "selection_policy": {
    "default_backend_priority": [
      "typescript_node",
      "http_openapi",
      "ipc_protocol"
    ]
  },
  "capabilities": [
    {
      "capability_id": "sdk.session.lifecycle",
      "required": true,
      "backends": [
        {
          "kind": "typescript_node",
          "driver_id": "driver.opencode.session.lifecycle.ts",
          "package": "@opencode-ai/sdk"
        }
      ]
    },
    {
      "capability_id": "sdk.model.chat",
      "required": true,
      "backends": [
        {
          "kind": "typescript_node",
          "driver_id": "driver.opencode.model.chat.ts",
          "package": "@opencode-ai/sdk"
        }
      ]
    },
    {
      "capability_id": "sdk.tool.invoke",
      "required": false,
      "backends": [
        {
          "kind": "typescript_node",
          "driver_id": "driver.opencode.tool.invoke.ts",
          "package": "@opencode-ai/sdk"
        }
      ]
    }
  ],
  "integration_sources": [
    {
      "mode": "official_sdk",
      "package": "@opencode-ai/sdk"
    },
    {
      "mode": "http_openapi",
      "transport": "openclaw-gateway-open-api"
    },
    {
      "mode": "ipc_protocol",
      "transport": "jsonrpc_stdio"
    }
  ]
}
