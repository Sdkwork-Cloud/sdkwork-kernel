# Kernel topology profile: cloud-hosted + split-services + production

SDKWORK_KERNEL_HOSTING=cloud-hosted
SDKWORK_KERNEL_SERVICE_LAYOUT=split-services
SDKWORK_KERNEL_ENVIRONMENT=production
SDKWORK_KERNEL_PROFILE_ID=cloud-hosted.split-services.production
SDKWORK_KERNEL_CONFIG_PROFILE=prod
SDKWORK_KERNEL_DEPLOYMENT_MODE=server
SDKWORK_KERNEL_RUNTIME_TARGET=server

SDKWORK_KERNEL_APPLICATION_PUBLIC_HTTP_URL=https://kernel.sdkwork.com
SDKWORK_KERNEL_APPLICATION_PUBLIC_WEBSOCKET_URL=wss://kernel.sdkwork.com

SDKWORK_KERNEL_PLATFORM_API_GATEWAY_HTTP_URL=https://api.sdkwork.com
SDKWORK_KERNEL_PLATFORM_API_GATEWAY_AUTOSTART=false

VITE_SDKWORK_KERNEL_HOSTING=cloud-hosted
VITE_SDKWORK_KERNEL_APPLICATION_PUBLIC_HTTP_URL=https://kernel.sdkwork.com
VITE_SDKWORK_KERNEL_APPLICATION_PUBLIC_WEBSOCKET_URL=wss://kernel.sdkwork.com
VITE_SDKWORK_KERNEL_PLATFORM_API_GATEWAY_HTTP_URL=https://api.sdkwork.com
VITE_KERNEL_API_URL=https://kernel.sdkwork.com

SDKWORK_KERNEL_INGRESS_AUTH_MODE=token
# Required at deploy time (never commit real values):
# SDKWORK_KERNEL_INGRESS_TOKEN=
# Token mode uses Signed identity; clients must send x-sdkwork-tenant-id,
# x-sdkwork-user-id, and x-sdkwork-identity-mac (HMAC-SHA256).
# Optional bound-identity mode (ignores client identity headers):
# SDKWORK_KERNEL_INGRESS_BOUND_TENANT_ID=
# SDKWORK_KERNEL_INGRESS_BOUND_USER_ID=
# Operational metrics: GET /metrics (Prometheus text; token auth in production via SDKWORK_KERNEL_METRICS_AUTH_MODE=token)
# Optional tracing: SDKWORK_OTEL_EXPORTER_OTLP_ENDPOINT (requires observability-otel build feature)

SDKWORK_AGENT_RUNTIME_DATABASE_ENGINE=postgres
# Required at deploy time (never commit real values):
# SDKWORK_AGENT_RUNTIME_DATABASE_URL=postgresql://user:pass@postgres:5432/sdkwork_agent_runtime
# SDKWORK_AGENT_RUNTIME_POSTGRES_URI=postgresql://user:pass@postgres:5432/sdkwork_agent_runtime
# SDKWORK_RATE_LIMIT_REDIS_URL=redis://redis:6379/0
SDKWORK_CORS_ORIGINS=https://kernel.sdkwork.com,https://app.sdkwork.com
