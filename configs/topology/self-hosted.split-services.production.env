# Kernel topology profile: self-hosted + split-services + production

SDKWORK_KERNEL_HOSTING=self-hosted
SDKWORK_KERNEL_SERVICE_LAYOUT=split-services
SDKWORK_KERNEL_ENVIRONMENT=production
SDKWORK_KERNEL_PROFILE_ID=self-hosted.split-services.production
SDKWORK_KERNEL_CONFIG_PROFILE=prod
SDKWORK_KERNEL_DEPLOYMENT_MODE=server
SDKWORK_KERNEL_RUNTIME_TARGET=server

SDKWORK_KERNEL_APPLICATION_PUBLIC_INGRESS_BIND=0.0.0.0:18280
SDKWORK_KERNEL_APPLICATION_PUBLIC_HTTP_URL=http://127.0.0.1:18280
SDKWORK_KERNEL_APPLICATION_PUBLIC_WEBSOCKET_URL=ws://127.0.0.1:18280

SDKWORK_KERNEL_PLATFORM_API_GATEWAY_HTTP_URL=http://127.0.0.1:3900
SDKWORK_KERNEL_PLATFORM_API_GATEWAY_AUTOSTART=false
SDKWORK_API_GATEWAY_BIND=0.0.0.0:3900

VITE_SDKWORK_KERNEL_HOSTING=self-hosted
VITE_SDKWORK_KERNEL_APPLICATION_PUBLIC_HTTP_URL=http://127.0.0.1:18280
VITE_SDKWORK_KERNEL_APPLICATION_PUBLIC_WEBSOCKET_URL=ws://127.0.0.1:18280
VITE_SDKWORK_KERNEL_PLATFORM_API_GATEWAY_HTTP_URL=http://127.0.0.1:3900
VITE_KERNEL_API_URL=http://127.0.0.1:18280

SDKWORK_KERNEL_INGRESS_AUTH_MODE=token
# Required at deploy time (never commit real values):
# SDKWORK_KERNEL_INGRESS_TOKEN=
# Bind 0.0.0.0 triggers Signed identity mode; clients must send signed identity headers.
# Operational metrics: GET /metrics (Prometheus text, no ingress auth)
# Optional bound-identity mode:
# SDKWORK_KERNEL_INGRESS_BOUND_TENANT_ID=
# SDKWORK_KERNEL_INGRESS_BOUND_USER_ID=

SDKWORK_CORS_ORIGINS=http://127.0.0.1:5179,http://localhost:5179

# Multi-replica / server production runtime (required when SDKWORK_KERNEL_RUNTIME_TARGET=server):
SDKWORK_AGENT_RUNTIME_DATABASE_ENGINE=postgres
# SDKWORK_AGENT_RUNTIME_DATABASE_URL=postgresql://user:pass@postgres:5432/sdkwork_agent_runtime
# SDKWORK_AGENT_RUNTIME_POSTGRES_URI=postgresql://user:pass@postgres:5432/sdkwork_agent_runtime
# SDKWORK_RATE_LIMIT_REDIS_URL=redis://redis:6379/0
