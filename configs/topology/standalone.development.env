# standalone.development
SDKWORK_KERNEL_DEPLOYMENT_PROFILE=standalone
VITE_SDKWORK_KERNEL_DEPLOYMENT_PROFILE=standalone
SDKWORK_KERNEL_ENVIRONMENT=development
SDKWORK_KERNEL_PROFILE_ID=standalone.development


# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_KERNEL_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN

SDKWORK_KERNEL_APPLICATION_PUBLIC_INGRESS_BIND=127.0.0.1:18280
SDKWORK_KERNEL_APPLICATION_PUBLIC_HTTP_URL=http://127.0.0.1:18280
SDKWORK_KERNEL_APPLICATION_PUBLIC_WEBSOCKET_URL=ws://127.0.0.1:18280
VITE_SDKWORK_KERNEL_APPLICATION_PUBLIC_HTTP_URL=http://127.0.0.1:18280
VITE_SDKWORK_KERNEL_APPLICATION_PUBLIC_WEBSOCKET_URL=ws://127.0.0.1:18280
SDKWORK_KERNEL_PLATFORM_API_GATEWAY_HTTP_URL=http://127.0.0.1:3900
VITE_SDKWORK_KERNEL_PLATFORM_API_GATEWAY_HTTP_URL=http://127.0.0.1:3900

SDKWORK_DATABASE_ENGINE=postgresql
SDKWORK_DATABASE_HOST=127.0.0.1
SDKWORK_DATABASE_PORT=5432
SDKWORK_DATABASE_NAME=sdkwork_ai_dev
SDKWORK_DATABASE_SCHEMA=sdkwork_ai_dev
SDKWORK_DATABASE_USERNAME=sdkwork_ai_dev
SDKWORK_DATABASE_PASSWORD=sdkworkdev123
SDKWORK_DATABASE_SSL_MODE=disable
