{
  "schema_version": "0.1.0",
  "manifest_type": "agent_sdk_binding",
  "binding_id": "binding.agent-sdk.claude-code",
  "agent_id": "agent.intelligence.claude-code",
  "display_name": "Claude Code",
  "description": "External agent SDK binding for Anthropic Claude Code CLI and agent SDK surfaces.",
  "version": "0.1.0",
  "sdk_owner": "anthropic",
  "status": "standardizing",
  "kernel_compatibility": {
    "agent_kernel": ">=0.1.0 <0.2.0"
  },
  "language_packages": {
    "typescript": {
      "package": "@anthropic-ai/claude-agent-sdk",
      "optional": false
    }
  },
  "selection_policy": {
    "default_backend_priority": [
      "typescript_node",
      "ipc_protocol"
    ]
  },
  "capabilities": [
    {
      "capability_id": "sdk.session.lifecycle",
      "required": true,
      "backends": [
        {
          "kind": "typescript_node",
          "driver_id": "driver.claude-code.session.lifecycle.ts",
          "package": "@anthropic-ai/claude-agent-sdk"
        },
        {
          "kind": "ipc_protocol",
          "driver_id": "driver.claude-code.session.lifecycle.ipc",
          "transport": "jsonrpc_stdio"
        }
      ]
    },
    {
      "capability_id": "sdk.model.chat",
      "required": true,
      "backends": [
        {
          "kind": "typescript_node",
          "driver_id": "driver.claude-code.model.chat.ts",
          "package": "@anthropic-ai/claude-agent-sdk"
        }
      ]
    },
    {
      "capability_id": "sdk.model.stream",
      "required": false,
      "backends": [
        {
          "kind": "typescript_node",
          "driver_id": "driver.claude-code.model.stream.ts",
          "package": "@anthropic-ai/claude-agent-sdk"
        }
      ]
    },
    {
      "capability_id": "sdk.tool.invoke",
      "required": false,
      "backends": [
        {
          "kind": "typescript_node",
          "driver_id": "driver.claude-code.tool.invoke.ts",
          "package": "@anthropic-ai/claude-agent-sdk"
        }
      ]
    }
  ]
}
