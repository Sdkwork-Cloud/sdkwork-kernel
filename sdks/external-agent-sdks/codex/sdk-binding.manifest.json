{
  "schema_version": "0.1.0",
  "manifest_type": "agent_sdk_binding",
  "binding_id": "binding.agent-sdk.codex",
  "agent_id": "agent.intelligence.codex",
  "display_name": "OpenAI Codex",
  "description": "External agent SDK binding for OpenAI Codex app-server and CLI runtimes.",
  "version": "0.1.0",
  "sdk_owner": "openai",
  "status": "standardizing",
  "kernel_compatibility": {
    "agent_kernel": ">=0.1.0 <0.2.0"
  },
  "language_packages": {
    "rust": {
      "crate": "codex-core",
      "version": ">=0.1.0",
      "optional": false
    },
    "typescript": {
      "package": "@openai/codex-sdk",
      "optional": false
    }
  },
  "selection_policy": {
    "default_backend_priority": [
      "typescript_node",
      "rust_native",
      "ipc_protocol"
    ]
  },
  "capabilities": [
    {
      "capability_id": "sdk.session.lifecycle",
      "required": true,
      "backends": [
        {
          "kind": "rust_native",
          "driver_id": "driver.codex.session.lifecycle.rust",
          "crate": "codex-core"
        },
        {
          "kind": "ipc_protocol",
          "driver_id": "driver.codex.session.lifecycle.ipc",
          "transport": "jsonrpc_stdio"
        }
      ]
    },
    {
      "capability_id": "sdk.session.history",
      "required": true,
      "backends": [
        {
          "kind": "rust_native",
          "driver_id": "driver.codex.session.history.rust",
          "crate": "codex-core"
        }
      ]
    },
    {
      "capability_id": "sdk.model.chat",
      "required": true,
      "backends": [
        {
          "kind": "typescript_node",
          "driver_id": "driver.codex.model.chat.ts",
          "package": "@openai/codex-sdk"
        },
        {
          "kind": "rust_native",
          "driver_id": "driver.codex.model.chat.rust",
          "crate": "codex-core"
        },
        {
          "kind": "ipc_protocol",
          "driver_id": "driver.codex.model.chat.ipc",
          "transport": "jsonrpc_stdio"
        }
      ]
    },
    {
      "capability_id": "sdk.model.stream",
      "required": false,
      "backends": [
        {
          "kind": "rust_native",
          "driver_id": "driver.codex.model.stream.rust",
          "crate": "codex-core"
        }
      ]
    },
    {
      "capability_id": "sdk.tool.invoke",
      "required": false,
      "backends": [
        {
          "kind": "rust_native",
          "driver_id": "driver.codex.tool.invoke.rust",
          "crate": "codex-core"
        }
      ]
    }
  ]
}
