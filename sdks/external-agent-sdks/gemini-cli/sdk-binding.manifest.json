{
  "schema_version": "0.1.0",
  "manifest_type": "agent_sdk_binding",
  "binding_id": "binding.agent-sdk.gemini-cli",
  "agent_id": "agent.intelligence.gemini",
  "display_name": "Gemini CLI",
  "description": "External agent SDK binding for Google Gemini CLI and SDK surfaces.",
  "version": "0.1.0",
  "sdk_owner": "google",
  "status": "standardizing",
  "kernel_compatibility": {
    "agent_kernel": ">=0.1.0 <0.2.0"
  },
  "language_packages": {
    "typescript": {
      "package": "@google/gemini-cli-sdk",
      "optional": false
    }
  },
  "selection_policy": {
    "default_backend_priority": [
      "typescript_node",
      "ipc_protocol"
    ]
  },
  "capabilities": [
    {
      "capability_id": "sdk.session.lifecycle",
      "required": true,
      "backends": [
        {
          "kind": "typescript_node",
          "driver_id": "driver.gemini-cli.session.lifecycle.ts",
          "package": "@google/gemini-cli-sdk"
        }
      ]
    },
    {
      "capability_id": "sdk.model.chat",
      "required": true,
      "backends": [
        {
          "kind": "typescript_node",
          "driver_id": "driver.gemini-cli.model.chat.ts",
          "package": "@google/gemini-cli-sdk"
        }
      ]
    },
    {
      "capability_id": "sdk.model.stream",
      "required": false,
      "backends": [
        {
          "kind": "typescript_node",
          "driver_id": "driver.gemini-cli.model.stream.ts",
          "package": "@google/gemini-cli-sdk"
        }
      ]
    },
    {
      "capability_id": "sdk.tool.invoke",
      "required": false,
      "backends": [
        {
          "kind": "typescript_node",
          "driver_id": "driver.gemini-cli.tool.invoke.ts",
          "package": "@google/gemini-cli-sdk"
        }
      ]
    }
  ]
}
