{
  "name": "@sdkwork/agent-internal-sdk",
  "version": "0.1.0",
  "description": "SDKWork agent internal API TypeScript SDK boundary.",
  "type": "module",
  "private": false,
  "sdkwork": {
    "sdkName": "sdkwork-agent-internal-sdk",
    "authority": "sdkwork-agent-internal-api",
    "apiPrefix": "/internal/v3/api",
    "sdkType": "custom",
    "sdkSurface": "internal",
    "generatedOutput": "generated/server-openapi",
    "standardProfile": "sdkwork-v3",
    "sdkOwner": "sdkwork-kernel",
    "sdkDependencies": []
  },
  "scripts": {
    "generate:dry-run": "node ../../workspace-agent-sdkgen.mjs --family internal --mode dry-run",
    "generate": "node ../../workspace-agent-sdkgen.mjs --family internal --mode apply",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit -p tsconfig.json",
    "test:contract": "node --experimental-strip-types --test tests/sse-parser.test.mjs tests/streaming.test.mjs",
    "verify": "node ../bin/verify-sdk.mjs"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "dependencies": {
    "@sdkwork/sdk-common": "workspace:*"
  },
  "devDependencies": {
    "typescript": "catalog:"
  }
}
