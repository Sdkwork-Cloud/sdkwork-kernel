{
  "schema_version": "0.1.0",
  "manifest_type": "provider",
  "provider_id": "provider.protocol_adapter.codex-process",
  "provider_family": "protocol_adapter",
  "name": "codex-process",
  "display_name": "Codex Process Adapter",
  "version": "0.1.0",
  "kernel_compatibility": {
    "agent_kernel": ">=0.1.0 <0.2.0"
  },
  "capabilities": [
    "protocol.process",
    "code.terminal.run",
    "code.patch.apply",
    "code.verification.run",
    "code.review.produce"
  ],
  "operations": [
    "describe",
    "launch",
    "stream",
    "cancel",
    "health"
  ],
  "configuration_schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "executable_ref": {
        "type": "string"
      },
      "working_directory_policy": {
        "type": "string"
      }
    }
  },
  "security_requirements": {
    "fail_closed": true,
    "required_policy_categories": [
      "host.process.execute",
      "host.filesystem.write",
      "host.network.connect",
      "host.secrets.read"
    ],
    "secret_handling": {
      "raw_secrets_in_manifest": false
    }
  },
  "health_model": {
    "states": [
      "available",
      "degraded",
      "unavailable"
    ]
  },
  "owner": {
    "name": "sdkwork-platform"
  },
  "status": "experimental",
  "extensions": {
    "sdkwork.external.source-path": "external/codex",
    "sdkwork.external.initial-registration-mode": "process-adapter",
    "sdkwork.external.execution-status": "not-implemented"
  }
}
