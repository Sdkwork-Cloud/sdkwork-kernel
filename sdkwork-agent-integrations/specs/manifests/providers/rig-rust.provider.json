{
  "schema_version": "0.1.0",
  "manifest_type": "provider",
  "provider_id": "provider.model.rig-rust",
  "provider_family": "model",
  "name": "rig-rust",
  "display_name": "Rig Rust Provider Candidate",
  "version": "0.1.0",
  "kernel_compatibility": {
    "agent_kernel": ">=0.1.0 <0.2.0"
  },
  "capabilities": [
    "model.catalog",
    "model.chat",
    "model.streaming",
    "model.tool_call",
    "tool.invoke",
    "memory.query",
    "memory.write",
    "memory.delete",
    "memory.export",
    "knowledge.search",
    "knowledge.read",
    "knowledge.list",
    "planning.create",
    "agent.install",
    "agent.configure"
  ],
  "operations": [
    "list_models",
    "describe_model",
    "chat",
    "stream",
    "list_tools",
    "invoke_tool",
    "query_memory",
    "write_memory",
    "delete_memory",
    "export_memory",
    "search_knowledge",
    "read_knowledge",
    "list_knowledge",
    "health"
  ],
  "configuration_schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "model_provider_id": {
        "type": "string"
      },
      "secret_ref": {
        "type": "string"
      }
    }
  },
  "security_requirements": {
    "fail_closed": true,
    "required_policy_categories": [
      "model.invoke",
      "model.send-sensitive-context",
      "tool.invoke",
      "memory.write",
      "memory.delete",
      "knowledge.search",
      "knowledge.read",
      "host.secrets.read"
    ],
    "secret_handling": {
      "raw_secrets_in_manifest": false
    }
  },
  "health_model": {
    "states": [
      "available",
      "degraded",
      "unavailable"
    ]
  },
  "owner": {
    "name": "sdkwork-platform"
  },
  "status": "experimental",
  "extensions": {
    "sdkwork.external.source-path": "external/rig",
    "sdkwork.external.initial-registration-mode": "typed-local-provider",
    "sdkwork.external.execution-status": "implemented-local-memory-knowledge-model-tool-fail-closed",
    "sdkwork.external.manifest-shape": "legacy-aggregate-provider-candidate; runtime code registers separate typed model/tool/memory/knowledge/planning/policy providers",
    "sdkwork.external.implementation-crate": "sdkwork-agent-integrations/crates/sdkwork-agent-integration-rig"
  }
}
