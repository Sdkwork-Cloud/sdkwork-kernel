{
  "schema_version": "0.1.0",
  "manifest_type": "provider",
  "provider_id": "provider.rig-rust",
  "provider_family": "model",
  "name": "rig-rust",
  "display_name": "Rig Rust Provider Candidate",
  "version": "0.1.0",
  "kernel_compatibility": {
    "agent_kernel": ">=0.1.0 <0.2.0"
  },
  "capabilities": [
    "model.catalog",
    "model.chat"
  ],
  "operations": [
    "list_models",
    "describe_model",
    "chat",
    "health"
  ],
  "configuration_schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "model_provider_id": {
        "type": "string"
      },
      "secret_ref": {
        "type": "string"
      }
    }
  },
  "security_requirements": {
    "fail_closed": true,
    "required_policy_categories": [
      "model.invoke",
      "model.send-sensitive-context",
      "host.secrets.read"
    ],
    "secret_handling": {
      "raw_secrets_in_manifest": false
    }
  },
  "health_model": {
    "states": [
      "available",
      "degraded",
      "unavailable"
    ]
  },
  "owner": {
    "name": "sdkwork-platform"
  },
  "status": "experimental",
  "extensions": {
    "sdkwork.external.source-path": "external/rig",
    "sdkwork.external.initial-registration-mode": "typed-local-provider",
    "sdkwork.external.default-health": "degraded",
    "sdkwork.external.execution-status": "rig-model-live-when-official-adapter-injected-otherwise-fail-closed",
    "sdkwork.external.manifest-shape": "split-provider-candidate; runtime code registers separate typed model/memory/knowledge/planning/policy providers, MCP resources/prompts, and adapter.rpc.agent-chat",
    "sdkwork.external.implementation-crate": "agent-providers/crates/sdkwork-agent-provider-rig"
  }
}
