{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sdkwork.example.invalid/kernel/schemas/agent-configuration-migration.schema.json",
  "title": "SDKWork Agent Configuration Migration",
  "type": "object",
  "required": [
    "schema_version",
    "manifest_type",
    "plan_id",
    "agent_id",
    "profile_id",
    "from_configuration_version",
    "to_configuration_version",
    "required_policy_categories",
    "steps"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "manifest_type": {
      "const": "agent_configuration_migration"
    },
    "plan_id": {
      "type": "string",
      "minLength": 1
    },
    "agent_id": {
      "type": "string",
      "minLength": 1
    },
    "profile_id": {
      "type": "string",
      "minLength": 1
    },
    "from_configuration_version": {
      "type": "string",
      "minLength": 1
    },
    "to_configuration_version": {
      "type": "string",
      "minLength": 1
    },
    "required_policy_categories": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["step_id", "kind", "field_key"],
        "properties": {
          "step_id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "preserve_value",
              "rename_field",
              "set_default",
              "remove_field",
              "preserve_secret_ref",
              "rebind_secret_ref"
            ]
          },
          "field_key": {
            "type": "string",
            "minLength": 1
          },
          "secret_binding_kind": {
            "enum": [
              "login_password",
              "login_token",
              "oauth_credential",
              "llm_api_key",
              "custom_secret"
            ]
          },
          "provider_hint": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
