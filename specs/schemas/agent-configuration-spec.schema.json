{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sdkwork.example.invalid/kernel/schemas/agent-configuration-spec.schema.json",
  "title": "SDKWork Agent Configuration Spec",
  "type": "object",
  "required": [
    "schema_version",
    "manifest_type",
    "agent_id",
    "sections"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "manifest_type": {
      "const": "agent_configuration_spec"
    },
    "agent_id": {
      "type": "string",
      "minLength": 1
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["section_id", "title", "kind", "fields"],
        "properties": {
          "section_id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "pattern": "^(base|login_auth|llm_api_key|runtime|security|custom|custom:[A-Za-z0-9_.-]+)$"
          },
          "custom_namespace": {
            "type": "string",
            "minLength": 1
          },
          "fields": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "key",
                "label",
                "value_kind",
                "required",
                "secret_ref_required",
                "redaction_classification"
              ],
              "properties": {
                "key": {
                  "type": "string",
                  "minLength": 1
                },
                "label": {
                  "type": "string",
                  "minLength": 1
                },
                "value_kind": {
                  "enum": [
                    "string",
                    "boolean",
                    "integer",
                    "secret_ref",
                    "string_list",
                    "json"
                  ]
                },
                "required": {
                  "type": "boolean"
                },
                "secret_ref_required": {
                  "type": "boolean"
                },
                "redaction_classification": {
                  "enum": [
                    "public",
                    "internal",
                    "tenant_sensitive",
                    "personal_data",
                    "secret",
                    "regulated",
                    "unknown"
                  ]
                },
                "description": {
                  "type": "string"
                },
                "default_value": {
                  "type": "object",
                  "required": ["value_kind", "value"],
                  "properties": {
                    "value_kind": {
                      "enum": [
                        "string",
                        "boolean",
                        "integer",
                        "secret_ref",
                        "string_list",
                        "json"
                      ]
                    },
                    "value": true
                  },
                  "additionalProperties": false
                }
              },
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "value_kind": {
                        "const": "secret_ref"
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "secret_ref_required": {
                        "const": true
                      },
                      "redaction_classification": {
                        "enum": [
                          "internal",
                          "tenant_sensitive",
                          "personal_data",
                          "secret",
                          "regulated",
                          "unknown"
                        ]
                      }
                    }
                  }
                }
              ],
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
