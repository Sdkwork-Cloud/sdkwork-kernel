{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sdkwork.example.invalid/kernel/schemas/agent-manifest.schema.json",
  "title": "SDKWork Agent Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest_type",
    "agent_id",
    "name",
    "display_name",
    "description",
    "version",
    "domain",
    "kernel_compatibility",
    "required_capabilities",
    "optional_capabilities",
    "provider_requirements",
    "protocol_adapters",
    "security_profile",
    "runtime_profile",
    "event_families",
    "owner",
    "status"
  ],
  "properties": {
    "schema_version": { "$ref": "#/$defs/semver" },
    "manifest_type": { "const": "agent" },
    "agent_id": { "type": "string", "pattern": "^agent\\.[a-z0-9.-]+\\.[a-z0-9.-]+$" },
    "name": { "$ref": "#/$defs/name" },
    "display_name": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "version": { "$ref": "#/$defs/semver" },
    "domain": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "kernel_compatibility": {
      "type": "object",
      "additionalProperties": { "type": "string", "minLength": 1 },
      "required": ["agent_kernel"],
      "properties": {
        "agent_kernel": { "type": "string", "minLength": 1 }
      }
    },
    "required_capabilities": {
      "type": "array",
      "items": { "$ref": "#/$defs/capabilityRequirement" }
    },
    "optional_capabilities": {
      "type": "array",
      "items": { "$ref": "#/$defs/capabilityRequirement" }
    },
    "provider_requirements": {
      "type": "array",
      "items": { "$ref": "#/$defs/providerRequirement" }
    },
    "protocol_adapters": {
      "type": "array",
      "items": { "$ref": "#/$defs/protocolAdapterRequirement" }
    },
    "security_profile": { "$ref": "#/$defs/securityProfile" },
    "runtime_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["modes"],
      "properties": {
        "modes": {
          "type": "array",
          "items": {
            "enum": ["local", "private", "saas", "desktop", "cli", "server", "embedded"]
          },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    "event_families": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z0-9.-]+\\.\\*$" },
      "uniqueItems": true
    },
    "owner": { "$ref": "#/$defs/owner" },
    "status": { "$ref": "#/$defs/status" },
    "tags": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "homepage": { "type": "string", "format": "uri" },
    "documentation": { "type": "string" },
    "license": { "type": "string" },
    "deprecation": { "$ref": "#/$defs/deprecation" },
    "extensions": { "$ref": "#/$defs/extensions" }
  },
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:[-+][0-9A-Za-z.-]+)?$"
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "status": {
      "enum": ["experimental", "candidate", "stable", "deprecated", "removed"]
    },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "contact": { "type": "string" },
        "url": { "type": "string" }
      }
    },
    "capabilityRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capability_id", "min_version"],
      "properties": {
        "capability_id": { "type": "string", "pattern": "^[a-z0-9.-]+$" },
        "min_version": { "$ref": "#/$defs/semver" },
        "required": { "type": "boolean" }
      }
    },
    "providerRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "required", "capabilities"],
      "properties": {
        "family": {
          "enum": ["model", "tool", "context", "memory", "planning", "policy", "telemetry", "host", "protocol_adapter", "mcp", "skill", "collaboration"]
        },
        "required": { "type": "boolean" },
        "capabilities": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-z0-9_.-]+$" },
          "uniqueItems": true
        }
      }
    },
    "protocolAdapterRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter_id", "required"],
      "properties": {
        "adapter_id": { "type": "string", "pattern": "^adapter\\.[a-z0-9.-]+\\.[a-z0-9.-]+$" },
        "required": { "type": "boolean" }
      }
    },
    "securityProfile": {
      "type": "object",
      "additionalProperties": true,
      "required": ["fail_closed", "required_policy_categories", "redaction_required"],
      "properties": {
        "fail_closed": { "type": "boolean" },
        "required_policy_categories": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-z0-9.-]+$" },
          "uniqueItems": true
        },
        "redaction_required": { "type": "boolean" }
      }
    },
    "deprecation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["deprecated_since", "replacement", "removal_not_before", "migration_notes"],
      "properties": {
        "deprecated_since": { "$ref": "#/$defs/semver" },
        "replacement": { "type": "string" },
        "removal_not_before": { "$ref": "#/$defs/semver" },
        "migration_notes": { "type": "string", "minLength": 1 }
      }
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "pattern": "^(sdkwork|[a-z0-9-]+\\.[a-z0-9.-]+)\\.[a-z0-9.-]+$"
      },
      "additionalProperties": true
    }
  }
}
