{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sdkwork.example.invalid/kernel/schemas/agent-runtime-diagnostics.schema.json",
  "title": "SDKWork Agent Runtime Diagnostics",
  "description": "Machine-readable runtime diagnostics for SDKWork Agent Kernel hosts.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "runtime_id",
    "agent_id",
    "state",
    "provider_count",
    "capability_count",
    "typed_provider_count",
    "manifest_only_provider_count",
    "missing_required_capabilities",
    "degraded_capabilities",
    "provider_diagnostics"
  ],
  "properties": {
    "schema_version": {
      "const": "agent_runtime_diagnostics.v1"
    },
    "runtime_id": {
      "type": "string",
      "minLength": 1
    },
    "agent_id": {
      "type": "string",
      "minLength": 1
    },
    "state": {
      "enum": ["ready", "degraded", "failed"]
    },
    "provider_count": {
      "type": "integer",
      "minimum": 0
    },
    "capability_count": {
      "type": "integer",
      "minimum": 0
    },
    "typed_provider_count": {
      "type": "integer",
      "minimum": 0
    },
    "manifest_only_provider_count": {
      "type": "integer",
      "minimum": 0
    },
    "missing_required_capabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "degraded_capabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "provider_diagnostics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/providerDiagnostic"
      }
    }
  },
  "$defs": {
    "providerDiagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider_id",
        "provider_family",
        "provider_version",
        "typed_registered",
        "capabilities"
      ],
      "properties": {
        "provider_id": {
          "type": "string",
          "minLength": 1
        },
        "provider_family": {
          "type": "string",
          "minLength": 1,
          "examples": [
            "model",
            "tool",
            "policy",
            "context",
            "memory",
            "knowledge",
            "planning",
            "host",
            "protocol_adapter",
            "mcp",
            "skill",
            "telemetry",
            "agent_installer",
            "agent_configuration"
          ]
        },
        "provider_version": {
          "type": "string",
          "minLength": 1
        },
        "typed_registered": {
          "type": "boolean"
        },
        "health": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status"],
          "properties": {
            "status": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    }
  }
}
