{
  "schemaVersion": 5,
  "kind": "sdkwork.app.topology",
  "appId": "sdkwork-kernel",
  "applicationCode": "kernel",
  "archetype": "realtime-application-platform",
  "profileRoot": "etc/topology",
  "profilePattern": "{deploymentProfile}.{environment}.env",
  "vocabulary": {
    "environment": {
      "allowed": [
        "development",
        "test",
        "staging",
        "production"
      ]
    },
    "connectivityPlane": {
      "allowed": [
        "application",
        "platform",
        "operations"
      ]
    },
    "deploymentProfile": {
      "allowed": [
        "standalone",
        "cloud"
      ]
    }
  },
  "defaults": {
    "developmentProfileId": "standalone.development",
    "productionProfileId": "cloud.production",
    "desktopBuildProfileId": "standalone.production"
  },
  "profileFiles": {
    "standalone.development": "etc/topology/standalone.development.env",
    "standalone.production": "etc/topology/standalone.production.env",
    "cloud.development": "etc/topology/cloud.development.env",
    "cloud.production": "etc/topology/cloud.production.env",
    "standalone.test": "etc/topology/standalone.test.env",
    "standalone.staging": "etc/topology/standalone.staging.env",
    "cloud.test": "etc/topology/cloud.test.env",
    "cloud.staging": "etc/topology/cloud.staging.env"
  },
  "envKeys": {
    "environment": "SDKWORK_KERNEL_ENVIRONMENT",
    "profileId": "SDKWORK_KERNEL_PROFILE_ID",
    "clientApiGatewayBaseUrl": "VITE_SDKWORK_KERNEL_PLATFORM_API_GATEWAY_HTTP_URL",
    "apiGatewayBaseUrl": "SDKWORK_KERNEL_PLATFORM_API_GATEWAY_HTTP_URL",
    "deploymentProfile": "SDKWORK_KERNEL_DEPLOYMENT_PROFILE",
    "clientDeploymentProfile": "VITE_SDKWORK_KERNEL_DEPLOYMENT_PROFILE",
    "runtimeTarget": "SDKWORK_KERNEL_RUNTIME_TARGET",
    "allowMockProviders": "SDKWORK_KERNEL_ALLOW_MOCK_PROVIDERS",
    "kernelAgentPlugin": "SDKWORK_KERNEL_AGENT_PLUGIN",
    "rateLimitRps": "SDKWORK_RATE_LIMIT_RPS",
    "rateLimitBurst": "SDKWORK_RATE_LIMIT_BURST",
    "rateLimitRedisUrl": "SDKWORK_RATE_LIMIT_REDIS_URL"
  },
  "surfaces": {
    "application.public-ingress": {
      "connectivityPlane": "application",
      "protocols": [
        "http",
        "websocket"
      ],
      "bindEnv": "SDKWORK_KERNEL_APPLICATION_PUBLIC_INGRESS_BIND",
      "httpUrlEnv": "SDKWORK_KERNEL_APPLICATION_PUBLIC_HTTP_URL",
      "websocketUrlEnv": "SDKWORK_KERNEL_APPLICATION_PUBLIC_WEBSOCKET_URL",
      "clientHttpEnv": "VITE_SDKWORK_KERNEL_APPLICATION_PUBLIC_HTTP_URL",
      "clientWebsocketEnv": "VITE_SDKWORK_KERNEL_APPLICATION_PUBLIC_WEBSOCKET_URL"
    },
    "platform.api-gateway": {
      "connectivityPlane": "platform",
      "protocols": [
        "http"
      ],
      "httpUrlEnv": "SDKWORK_KERNEL_PLATFORM_API_GATEWAY_HTTP_URL",
      "clientHttpEnv": "VITE_SDKWORK_KERNEL_PLATFORM_API_GATEWAY_HTTP_URL"
    }
  },
  "cloudPublicHosts": {
    "application.public-ingress": {
      "httpHost": "kernel.sdkwork.com"
    },
    "platform.api-gateway": {
      "httpHost": "api.sdkwork.com"
    }
  },
  "components": {
    "agentServer": {
      "crate": "sdkwork-agent-server",
      "binary": "sdkwork-agent-server"
    }
  },
  "orchestration": {
    "profiles": {
      "standalone.development": {
        "processes": [
          {
            "id": "application.public-ingress",
            "crate": "sdkwork-agent-server",
            "binary": "sdkwork-agent-server",
            "required": true,
            "role": "api-standalone-gateway"
          }
        ],
        "capabilitySubset": [
          "application-http",
          "application-websocket"
        ],
        "healthSurfaces": [
          "application.public-ingress"
        ]
      },
      "standalone.production": {
        "processes": [
          {
            "id": "application.public-ingress",
            "crate": "sdkwork-agent-server",
            "binary": "sdkwork-agent-server",
            "required": true,
            "role": "api-standalone-gateway"
          }
        ],
        "healthSurfaces": [
          "application.public-ingress"
        ]
      },
      "cloud.development": {
        "processes": [],
        "healthSurfaces": [
          "application.public-ingress",
          "platform.api-gateway"
        ]
      },
      "cloud.production": {
        "processes": [
          {
            "id": "application.public-ingress",
            "crate": "sdkwork-agent-server",
            "binary": "sdkwork-agent-server",
            "required": true,
            "role": "api-standalone-gateway"
          }
        ],
        "healthSurfaces": [
          "application.public-ingress",
          "platform.api-gateway"
        ]
      },
      "standalone.test": {
        "processes": [
          {
            "id": "application.public-ingress",
            "crate": "sdkwork-agent-server",
            "binary": "sdkwork-agent-server",
            "required": true,
            "role": "api-standalone-gateway"
          }
        ],
        "capabilitySubset": [
          "application-http",
          "application-websocket"
        ],
        "healthSurfaces": [
          "application.public-ingress"
        ]
      },
      "standalone.staging": {
        "processes": [
          {
            "id": "application.public-ingress",
            "crate": "sdkwork-agent-server",
            "binary": "sdkwork-agent-server",
            "required": true,
            "role": "api-standalone-gateway"
          }
        ],
        "healthSurfaces": [
          "application.public-ingress"
        ]
      },
      "cloud.test": {
        "processes": [],
        "healthSurfaces": [
          "application.public-ingress",
          "platform.api-gateway"
        ]
      },
      "cloud.staging": {
        "processes": [
          {
            "id": "application.public-ingress",
            "crate": "sdkwork-agent-server",
            "binary": "sdkwork-agent-server",
            "required": true,
            "role": "api-standalone-gateway"
          }
        ],
        "healthSurfaces": [
          "application.public-ingress",
          "platform.api-gateway"
        ]
      }
    }
  },
  "scripts": {
    "kernelDev": "scripts/kernel-dev.mjs"
  },
  "retired": {
    "envKeys": [
      "SDKWORK_KERNEL_TOPOLOGY",
      "VITE_KERNEL_TOPOLOGY",
      "SDKWORK_KERNEL_HOSTING",
      "VITE_SDKWORK_KERNEL_HOSTING",
      "SDKWORK_BIND_ADDRESS",
      "SDKWORK_PORT",
      "SDKWORK_KERNEL_ALLOW_MOCK_FALLBACK"
    ],
    "notes": "Use hosting/serviceLayout/environment profile ids and application.public-ingress surface keys instead of legacy topology selectors.",
    "vocabulary": {
      "hosting": [
        "self-hosted",
        "cloud-hosted"
      ]
    }
  },
  "packaging": {
    "cloudConfigFiles": [],
    "targets": [
      {
        "id": "container-noarch-cloud-container-config-bundle-tar-gz",
        "profile": "container",
        "platform": "container",
        "architecture": "noarch",
        "formats": [
          "tar.gz"
        ],
        "runner": "ubuntu-24.04",
        "outputGlob": "dist/cloud-config/sdkwork-kernel-api-gateway-config-*.tar.gz",
        "deploymentProfile": "cloud",
        "runtimeTarget": "container",
        "variant": "config-bundle"
      }
    ]
  }
}
